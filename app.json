{
  "expo": {
    "name": "Kuttberg HQ",
    "slug": "kuttberg-hq",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "kuttberg-hq",
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-font",
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ],
      "expo-status-bar"
    ],
    "ios": {
      "bundleIdentifier": "com.mkutts.kuttberghq",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.kuttberghq"
    },
    "extra": {
      "router": {
        "sitemap": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "32c14ce4-a3e8-4dcd-af19-49cdc676b3bb"
      }
    },
    "owner": "mkutts"
  }
}
