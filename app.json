{
  "expo": {
    "name": "Kuttberg HQ",
    "slug": "kuttberg-hq",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/32c14ce4-a3e8-4dcd-af19-49cdc676b3bb",
      "checkAutomatically": "NEVER"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "kuttberg-hq",
    "icon": "./assets/images/KuttbergHQ_iOS_App_Icon_1024.png",
    "plugins": [
      [
        "expo-router",
        {
          "sitemap": false
        }
      ],
      "expo-font",
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/KuttbergHQ_Splash_Screen_Logo_1024_Transparent.png",
          "backgroundColor": "#FEEED0",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.mkutts.kuttberghq",
      "icon": "./assets/images/KuttbergHQ_iOS_App_Icon_1024.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mkutts.kuttberghq",
      "icon": "./assets/images/KuttbergHQ_Android_Legacy_App_Icon_1024.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/KuttbergHQ_Android_Adaptive_Foreground_1024.png",
        "backgroundImage": "./assets/images/KuttbergHQ_Android_Adaptive_Background_1024.png"
      }
    },
    "extra": {
      "router": {
        "sitemap": false,
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "32c14ce4-a3e8-4dcd-af19-49cdc676b3bb"
      }
    },
    "owner": "mkutts"
  }
}
